{
  "name": "spatial-media-explorer-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "check-types": "tsc -b --pretty false",
    "format": "oxfmt --write src package.json tsconfig.json vite.config.ts",
    "format:check": "oxfmt --check src package.json tsconfig.json vite.config.ts",
    "lint": "oxlint src",
    "test": "vitest run",
    "verify": "bun run format:check && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@moritzbrantner/ui": "^1.0.0",
    "@tanstack/react-query": "^5.100.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "packageManager": "bun@1.4.4"
}
